":null},{"id":"602159119046279650","text":"หาก 2 ไลน์อาหาร\nหน้างาน เกิด ปัญหาด้านใด สามารถแจ้งได้เลยนะคะ\n\nเดี๋ยวโอ๋ อธิบายกับเจ้าภาพให้ค่า เพื่อจะได้เข้าใจตรงกันค่า 🙏🏻","type":"incoming","sender":"user","timestamp":1771746107933,"status":null,"adminId":null,"adminName":null,"mediaType":null,"mediaUrl":null,"previewUrl":null},{"id":"602159216656384326","text":"เพราะทางเจ้าภาพ และแขก ชอบรสชาติ อาหาร ของทาง iris มากๆค่า","type":"incoming","sender":"user","timestamp":1771746166244,"status":null,"adminId":null,"adminName":null,"mediaType":null,"mediaUrl":null,"previewUrl":null},{"id":"602160320797999637","text":"ขอบคุณมากๆเลยค่า","type":"incoming","sender":"user","timestamp":1771746824344,"status":null,"adminId":null,"adminName":null,"mediaType":null,"mediaUrl":null,"previewUrl":null},{"id":"602167888899736002","text":"ขอบคุณค่ะ \nเดี๋ยว คอนเฟิร์มกับทางเจ้าภาพ แล้วจะแจ้งไปนะคะ","type":"incoming","sender":"user","timestamp":1771751335276,"status":null,"adminId":null,"adminName":null,"mediaType":null,"mediaUrl":null,"previewUrl":null},{"id":"602727902001496866","text":"สอบถามเพิ่มเติมค่ะ\n\nถ้าเจ้าภาพ ต้องการ จ้างไลน์บุฟเฟ่ต์เช้า ด้วย (พอดีมีงานบุญค่ะ)\n\nในวันที่ 14 มีนาคม \nยังมีคิวว่างไหมคะ","type":"incoming","sender":"user","timestamp":1772085129000,"status":null,"adminId":null,"adminName":null,"mediaType":null,"mediaUrl":null,"previewUrl":null},{"id":"602727912034009159","text":"มาสอบถามคิวเผื่อไว้ก่อนค่ะ","type":"incoming","sender":"user","timestamp":1772085135059,"status":null,"adminId":null,"adminName":null,"mediaType":null,"mediaUrl":null,"previewUrl":null},{"id":"602728781278609411","text":"ขอบคุณมากๆค่ะ ยังไงจะมาแจ้งนะคะ","type":"incoming","sender":"user","timestamp":1772085653159,"status":null,"adminId":null,"adminName":null,"mediaType":null,"mediaUrl":null,"previewUrl":null},{"id":"602735527565459787","text":"สอบถามงานเย็นนะคะ\nที่จองคิวไว้\n\nเจ้าภาพอยากได้แพคเกจ\n\n50 ท่าน อาหาร 5 อย่าง = 2 แพคเกจ\n\n40 ท่าน อาหาร 5 อย่าง = 2 แพคเกจ\n\n✅ รวมทั้งหมด จะเป็น