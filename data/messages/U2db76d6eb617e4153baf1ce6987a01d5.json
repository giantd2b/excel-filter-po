tatus":null,"adminId":null,"adminName":null,"mediaType":null,"mediaUrl":null,"previewUrl":null},{"id":"595069110665085611","text":"อยากได้ราคาต่อหัวประมาณ250-400 บาทค่ะ (อาหาร+เครื่องดื่ม)","type":"incoming","sender":"user","timestamp":1767520133773,"status":null,"adminId":null,"adminName":null,"mediaType":null,"mediaUrl":null,"previewUrl":null},{"id":"595069212100395068","text":"ขอรายละเอียดด้วยค่าา","type":"incoming","sender":"user","timestamp":1767520194236,"status":null,"adminId":null,"adminName":null,"mediaType":null,"mediaUrl":null,"previewUrl":null},{"id":"597514541244874909","text":"ขอสอบถามเพิ่มเติมนะคะ \n1. รบกวนขอดูตัวอย่างที่เคยจัดมั้ยคะ\n2. สามารถเข้าไปชิมอาหารได้มั้ยคะ ขอดูไลน์อาหารเบื้องต้นค่ะ\n3. มีพิธีกรและคนรันงานด้วยมั้ยคะ\n4. ถ้าอยากได้รูปแบบโต๊ะแบบ long table มีมั้ยคะ \nคำถามเบื้องต้นคะ","type":"incoming","sender":"user","timestamp":1768977723871,"status":null,"adminId":null,"adminName":null,"mediaType":null,"mediaUrl":null,"previewUrl":null},{"id":"597516461967671502","text":"1. รบกวนดูภาพที่เคยจัดหน่อยค่ะ (รายละเอียดพวกพิธีนี่คืออยู่ในส่วนออแกไนซ์เข้าใจถูกมั้ยคะ)\n2. มีเมนูอาหารเบื้องต้นให้ดูก่อนมั้ยคะ\n3. ขอบคุณค่ะ\n4. เก้าอี้ปกติเป็นแบบไหนคะ ถ้าหากรับแบบอื่นค่าใช้จ่ายคิดยังไงคะ","type":"incoming","sender":"user","timestamp":1768978868698,"status":null,"adminId":null,"adminName":null,"mediaType":null,"mediaUrl":null,"previewUrl":null},{"id":"597516506830209315","text":"ขออีกเรื่องนะคะ อันนี้มีพนักงานเก็บงาน เสิร์ฟ รวมด้วยมั้ยคะ","type":"incoming","sender":"user","timestamp":1768978895529,"status":null,"adminId":null,"adminName":null,"mediaType":null,"mediaUrl":null,"previewUrl":null},{"id":"597516777781461476","text":"รบกวนขอดู 2 แบบเลยคะ","type":"incoming","sender":"user","timestamp":1768979056982,"status":null,"adminId":null,"adminName":null,"mediaType":null,"mediaUrl":null,"previewUrl":null},{"id":"597516830025974038","text":"แล้วเก้าอี้แบบอื่นมีตัวอย่างมั้ยคะ","type":"incoming","sender":"user","timestamp":1768979088043,"status":null,"admi