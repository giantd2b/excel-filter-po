{"userId":"Uf9cd32bf408f9d3c5581ab7f443b7ebf","channel":"Line_IRIS","displayName":"Rose P. 365","messageCount":35,"messages":[{"id":"593298852888183268","text":"สวัสดีค่ะ สอบถามค่ะ ตอนนี้แพคเกจพิธีสงฆ์ยังเหมือนเดิมหรือมีเปลี่ยนแปลงราคามั้ยคะ","type":"incoming","sender":"user","timestamp":1766464977885,"status":null,"adminId":null,"adminName":null,"mediaType":null,"mediaUrl":null,"previewUrl":null},{"id":"593302231969956393","text":"ต้องการจัดพิธีสงฆ์ครบวงจรสองที่(ที่เดิมค่ะ)\n\n\n⚠️ วันที่ 29 ธันวาคม 68\nบจก.พีเอสเอส เทรลเลอร์แอนด์เซอร์วิส\n(เคยใช้บริการในนาม บจก.พอเพียงเซอร์วิส)\nพิกัด: บางพระ ศรีราชา\n\n\n⚠️ วันที่ 6 มกราคม 69\nบจก.สยามอีเลฟเฟนท์ เซอร์วิส\nพิกัด: หนองใหญ่\n\n\nสนใจเป็นตัวแพ็คเกจเดิม จำนวนแขก 20 ท่าน และนิมนต์พระท่านเอง เลี้ยงพระเพล ทั้งสองที่ค่ะ\n\n\nรบกวนออกใบเสนอราคาของแต่ละบริษัทให้ด้วยนะคะ\nขอบคุณมากค่ะ\n\n(ปล. มีโปรส่วนลดสำหรับลูกค้าเดิมให้มั้ยคะ)","type":"incoming","sender":"user","timestamp":1766466991953,"status":null,"adminId":null,"adminName":null,"mediaType":null,"mediaUrl":null,"previewUrl":null},{"id":"593303607936549326","text":"16/01 ว่างมั้ยคะ","type":"incoming","sender":"user","timestamp":1766467812048,"status":null,"adminId":null,"adminName":null,"mediaType":null,"mediaUrl":null,"previewUrl":null},{"id":"593306507962745127","text":"โอเคค่ะ วันที่ 16/01 ค่ะ","type":"incoming","sender":"user","timestamp":1766469540706,"status":null,"adminId":null,"adminName":null,"mediaType":null,"mediaUrl":null,"previewUrl":null},{"id":"593314647226974278","text":"ใช่ค่ะ","type":"incoming","sender":"user","timestamp":1766474391913,"status":null,"adminId":null,"adminName":null,"mediaType":null,"mediaUrl":null,"previewUrl":null},{"id":"593329146533774217","text":"โอเคค่ะ สักครู่ค่ะ","type":"incoming","sender":"user","timestamp":1766483034201,"status":null,"adminId":null,"adminName":null,"mediaType":null,"mediaUrl":null,"previewUrl":null},{"id":"593329290834084080","text":"PANUS MAWIM พนัสมาวิม\n092 298 9632\nhttps://maps.app.goo.gl/QBYbv7qgs56cNA7m8