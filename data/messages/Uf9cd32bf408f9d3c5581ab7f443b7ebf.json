ediaType":null,"mediaUrl":null,"previewUrl":null},{"id":"593439286641819807","text":"โอเคค่ะ / เดี๋ยวถ้าเลือกได้แล้วจะแจ้งไปค่ะ","type":"incoming","sender":"user","timestamp":1766548682833,"status":null,"adminId":null,"adminName":null,"mediaType":null,"mediaUrl":null,"previewUrl":null},{"id":"593473838562673108","text":"เมนูอาหารค่ะ\n\n⚠️ วันที่ 6 มกราคม (บางพระ) ⚠️\n\n1. ต้มยำปลาดุก ใบมะขามอ่อน\n2. แกงคั่วสับปะรด หอยแมลงภู่\n3. น่องไก่เล็กปีกบน ทอดสมุนไพร\n4. ปลาทอดผัดพริกไทยดำ\n5. เต้าหู้ทรงเครื่องน้ำแดงเห็ดหอม\n6. ลอดช่อง แตงไทย เผือก น้ำกะทิ\n\n\n\n\n⚠️ วันที่ 16 มกราคม (หนองใหญ่) ⚠️\n\n1. ต้มโคล้ง ปลาดุกกรอบ\n2. แกงคั่วสับปะรด หอยแมลงภู่\n3. น่องไก่เล็กปีกบน ทอดเหล้าแดง\n4. ปลาทอดผัดพริกไทยดำ\n5. ซี่โครงหมูอ่อน อบซอสยอดผัก\n6. ลอดช่อง แตงไทย เผือก น้ำกะทิ\n\n","type":"incoming","sender":"user","timestamp":1766569277325,"status":null,"adminId":null,"adminName":null,"mediaType":null,"mediaUrl":null,"previewUrl":null},{"id":"593572030390731487","text":"16 หนองใหญ่ค่ะ","type":"incoming","sender":"user","timestamp":1766627804337,"status":null,"adminId":null,"adminName":null,"mediaType":null,"mediaUrl":null,"previewUrl":null},{"id":"593572145801199908","text":"เพิ่งเห็นในใบเสนอราคาค่ะ / ขอเปลี่ยนสลับวันที่นะคะ","type":"incoming","sender":"user","timestamp":1766627873026,"status":null,"adminId":null,"adminName":null,"mediaType":null,"mediaUrl":null,"previewUrl":null},{"id":"593572169506881660","text":"16 ขอเป็นของใหญ่ค่ะ","type":"incoming","sender":"user","timestamp":1766627887284,"status":null,"adminId":null,"adminName":null,"mediaType":null,"mediaUrl":null,"previewUrl":null},{"id":"593580537848005157","text":"Confirmed ka","type":"incoming","sender":"user","timestamp":1766632875055,"status":null,"adminId":null,"adminName":null,"mediaType":null,"mediaUrl":null,"previewUrl":null},{"id":"595066131351077326","text":"โอเคค่ะ","type":"incoming","sender":"user","timestamp":1767518357786,"status":null,"adminId":null,"adminName":null,"mediaType":null,"mediaUrl":null,"preview