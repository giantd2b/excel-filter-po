าง\n1. ลอดช่อง แตงไทย เผือก น้ำกะทิ\n\nน้ำดื่ม / แถมน้ำสมุนไพร","type":"incoming","sender":"user","timestamp":1771940096374,"status":null,"adminId":null,"adminName":null,"mediaType":null,"mediaUrl":null,"previewUrl":null},{"id":"602484620138906032","text":"เมนูที่ผมเลือก ครับ","type":"incoming","sender":"user","timestamp":1771940121725,"status":null,"adminId":null,"adminName":null,"mediaType":null,"mediaUrl":null,"previewUrl":null},{"id":"602560804805673218","text":"ได้คิวนัดเข้าดูสถานที่จัดงานจริง\nแจ้งผมล่วงหน้าด้วยนะ\n\nบางเสาร์ผมก็ไม่ได้ขึ้นไปบ้านพัทยา ครับ","type":"incoming","sender":"user","timestamp":1771985531326,"status":null,"adminId":null,"adminName":null,"mediaType":null,"mediaUrl":null,"previewUrl":null},{"id":"603545733936709634","text":"สวัสดี สอบถาม ติดตามงาน ครับ\n\n1. ได้คิวนัดเข้าดูสถานที่จัดงานจริงวันไหน\nผมจะว่างขึ้นไปแค่สัปดาห์นี้\n\nเหตุผล หลังจากนั้นผมติดธุระยาวเลย\n-ลูกสอบปลายภาค 09-11\n-งานปัจฉิม 12\n-เรียนพิเศษ ติวข้อสอบ เตรียมสอบเข้าม.1 \n(เสาร์-อาทิตย์) 14,15,21,22\n-สมัครสอบ 19\n-สอบคัดเลือก28\n\n\n2. วันที่เข้าจัดเตรียมงานและอุปกรณ์ \nเป็นวันไหน\n\n3. รายละเอียดแผนงานจริง(เลี้ยงพระเพล)\nคือตามตารางที่ผมส่งให้เลยใช่ไหม\nเริ่มงาน 10.00น. นะ\nผมจะได้บอกแขกที่จะมางานตามที่ระบุบในตารางเลยนะ\n\nรบกวนช่วยตอบกลับหน่อยนะครับ","type":"incoming","sender":"user","timestamp":1772572594885,"status":null,"adminId":null,"adminName":null,"mediaType":null,"mediaUrl":null,"previewUrl":null},{"id":"603907537720574760","text":"เป็นเช้า9โมง หรือเย็น17.00น. เลยได้ไหม","type":"incoming","sender":"user","timestamp":1772788246771,"status":null,"adminId":null,"adminName":null,"mediaType":null,"mediaUrl":null,"previewUrl":null},{"id":"603907593169535068","text":"ผมนัดลูกค้าที่ระยอง11.30 น.กลัวกลับมาไม่ทันครับ","type":"incoming","sender":"user","timestamp":1772788279850,"status":null,"adminId":null,"adminName":null,"mediaType":null,"mediaUrl":null,"previewUrl":null},{"id":"604056654338326907","text":"สวัสดี ที่นัดเข้ามาดูสถานที่จัดงาน\nวันนี้ตอน17.00น. เข้ามาใกล้ถ