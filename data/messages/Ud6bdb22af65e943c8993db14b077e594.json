้องคอนเฟิร์ม คอร์ส ภายในไม่เกินตอนไหน คับ","type":"incoming","sender":"user","timestamp":1768899411006,"status":null,"adminId":null,"adminName":null,"mediaType":null,"mediaUrl":null,"previewUrl":null},{"id":"597386189821182228","text":"วันอาทิตย์ หรือวันเสาร์นี้\n\nผมไป ชิมได้ กี่คำ ครับ กี่อย่าง พอดี จะพาครอบครัวไปด้วย คับ","type":"incoming","sender":"user","timestamp":1768901220497,"status":null,"adminId":null,"adminName":null,"mediaType":null,"mediaUrl":null,"previewUrl":null},{"id":"598287790110933201","text":"ชิมฟรี 3 รายการหากเพิ่มจะมีค่าใช้จ่ายขึ้นอยู่กับเมนูค่ะ เเจ้งล่วงหน้า\nสิ่งที่ต้องเเจ้งเมื่อต้องการคอนเฟิร์มนัดชิม\n\n1. เลือกแพคเกจที่ต้องการนัดชิม\n👉 อาหาร 7 อย่าง\nสำหรับแขก = 100 ท่าน\n\n2. จำนวนแขกนัดชิม\n👉 2 คน\n\n3. แจ้งเมนู\n👉\n1. สปาเก็ตตี้เส้นดำไส้กรอกรมควัน ราดซอสมะเขือเทศ\n2. กระทงทอง ไส้ปลาแนมส้มซ่า\n3. กุ้งค็อคเทลข้าวโพด\n\n4. วันและเวลา\n👉 วันเสาร์ ที่ 31/1/69\nเวลา 14.00 น. ","type":"incoming","sender":"user","timestamp":1769438616210,"status":null,"adminId":null,"adminName":null,"mediaType":null,"mediaUrl":null,"previewUrl":null},{"id":"598287806922228224","text":"confirm ผมทีนะครับ ว่าได้ตามนี้ไหมครับ","type":"incoming","sender":"user","timestamp":1769438626177,"status":null,"adminId":null,"adminName":null,"mediaType":null,"mediaUrl":null,"previewUrl":null},{"id":"598348333781614973","text":"ขอ Add ที่จะเสาร์นี้\n\nBBQ ไก่ = 2 ไม้ ด้วยได้ไหมคับ?\nคิด คชจ. ต่อไม้ได้ครับ","type":"incoming","sender":"user","timestamp":1769474702953,"status":null,"adminId":null,"adminName":null,"mediaType":null,"mediaUrl":null,"previewUrl":null},{"id":"598358437609079042","text":"อุทิศ 080-640-7364","type":"incoming","sender":"user","timestamp":1769480725306,"status":null,"adminId":null,"adminName":null,"mediaType":null,"mediaUrl":null,"previewUrl":null},{"id":"598358461919264828","text":"https://maps.app.goo.gl/LKNL8vciYLhY4SC68?g_st=il","type":"incoming","sender":"user","timestamp":1769480739855,"status":null,"adminId":null,"adminName":null,"mediaType":null