{"userId":"U3a854aa52392c2bfedf05db43acc2279","channel":"Line_เติมบุญ","displayName":"Kwanchanok A.","messageCount":14,"messages":[{"id":"594950364483289457","text":"สนใจแพ็ค้กจนี้ค่ะ ขอรายละเอียดเพิ่มเติมด้วยค่ะ สถานที่จัดงาน ใกล้ๆบิ๊กซีบางพลีค่ะ แถวสี่แยกคลองขุด","type":"incoming","sender":"user","timestamp":1767449355518,"status":null,"adminId":null,"adminName":null,"mediaType":null,"mediaUrl":null,"previewUrl":null},{"id":"595026507055759616","text":"20 กุมภทค่ะ","type":"incoming","sender":"user","timestamp":1767494739863,"status":null,"adminId":null,"adminName":null,"mediaType":null,"mediaUrl":null,"previewUrl":null},{"id":"595026992001974394","text":"รบกวนขอใบเสนอนะคะ พร้อมรายละเอียดเพิ่มเติม ใช้เวลาจัดงาน เมนูอาหาร \n\nกำหนดจัดงาน 20 กุมภาพันธ์ 2569\n\nผู้ติดต่อ ขวัญชนก อภิวัฒนานนท์ 0982562553 ,0618236411\n\nสถานที่จัดงาน บริษัท เวสท์บาวด์ เอ็นจิเนียริ่ง จํากัด สาขาบางพลี 81/58-61 หมู่ 20 ถนนเทพารักษ์ ตําบลบางพลีใหญ่ อําเภอบางพลี จังหวัดสมุทรปราการ \n\nเลี้ยง พระเพล\n\nจํานวนพระ 9 รูป\n\nออกใบเสนอราคาในนาม บริษัท เวสท์บาวด์ เอ็นจิเนียริ่ง จำกัด","type":"incoming","sender":"user","timestamp":1767495028969,"status":null,"adminId":null,"adminName":null,"mediaType":null,"mediaUrl":null,"previewUrl":null},{"id":"595029914156007942","text":"ใช่ค่ะ","type":"incoming","sender":"user","timestamp":1767496770708,"status":null,"adminId":null,"adminName":null,"mediaType":null,"mediaUrl":null,"previewUrl":null},{"id":"595030314561044825","text":"ออกใบกํากับภาษีมี vat หักณที่จ่าย 3% ค่ะ","type":"incoming","sender":"user","timestamp":1767497009313,"status":null,"adminId":null,"adminName":null,"mediaType":null,"mediaUrl":null,"previewUrl":null},{"id":"595041874281759438","text":"0105529003540","type":"incoming","sender":"user","timestamp":1767503899613,"status":null,"adminId":null,"adminName":null,"mediaType":null,"mediaUrl":null,"previewUrl":null},{"id":"595043538312364479","text":"แต่หน้างานเราอยู่ที่ บริษัท เวสท์บาวด์ เอ็นจิเนียริ่ง จํากัด สาขาบางพลี 81/58-61 หมู่ 20 ถนนเทพารักษ์ ตําบลบางพลีใหญ่ อําเภอบางพลี จังหวัดสมุทรปราการ  \n\nแจ้งไว้ก่อนมันคนละที่กับที่อยู่ออกใบกำกับภาษี","type":"incoming","sender":"user","timestamp":1767504891284,"status":null,"adminId":null,"adminName":null,"mediaType":null,"mediaUrl":null,"previewUrl":null},{"id":"595043624815690145","text":"หน้างานเราเป็นอาคารพาณฺิชย์ จะจัดให้อยู่ใน 1 ห้องค่ะ แล้วแขกนั่งด้านนอกอาคาร (ของเราเป็นตึกริมมีพื่นที่ด้านข้างนิดหน่อย และมีพื้นพี่ด้านหน้าค่ะ)","type":"incoming","sender":"user","timestamp":1767504942844,"status":null,"adminId":null,"adminName":null,"mediaType":null,"mediaUrl":null,"previewUrl":null},{"id":"595043656440742353","text":"https://maps.app.goo.gl/kZLqeLGKMucj5Ga36","type":"incoming","sender":"user","timestamp":1767504961694,"status":null,"adminId":null,"adminName":null,"mediaType":null,"mediaUrl":null,"previewUrl":null},{"id":"595043751215497576","text":"เดี๋ยวเสนอเจ้านายก่อนนะคะ","type":"incoming","sender":"user","timestamp":1767505018301,"status":null,"adminId":null,"adminName":null,"mediaType":null,"mediaUrl":null,"previewUrl":null},{"id":"596509396255637883","text":"ชั้น 1 ค่ะ","type":"incoming","sender":"user","timestamp":1768378610702,"status":null,"adminId":null,"adminName":null,"mediaType":null,"mediaUrl":null,"previewUrl":null},{"id":"596509468565700712","text":"อยากให้มาดูสถานที่ว่าพระ 9 รูปจะลงพอไหใ ค่อนข้างแคบ แต่ถ้าลงไม่ได้จริงๆจะ 5 รูปก็ได้ค่ะ","type":"incoming","sender":"user","timestamp":1768378653872,"status":null,"adminId":null,"adminName":null,"mediaType":null,"mediaUrl":null,"previewUrl":null},{"id":"596509563339931870","text":"เดี๋ยวถ้าโอนมัจำไว้เพื่อจองวันได้เลยใช่ไหมคะ","type":"incoming","sender":"user","timestamp":1768378710290,"status":null,"adminId":null,"adminName":null,"mediaType":null,"mediaUrl":null,"previewUrl":null},{"id":"596510363411809145","text":"โอเคค่ะ เดี๋ยวมาประเมินหน้างานอีกทีหรือว่าจะให้ทางเราวัดพื้นที่ไปให้ค่ะ","type":"incoming","sender":"user","timestamp":1768379187178,"status":null,"adminId":null,"adminName":null,"mediaType":null,"mediaUrl":null,"previewUrl":null}]}