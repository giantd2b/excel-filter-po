coming","sender":"user","timestamp":1773540339131,"status":null,"adminId":null,"adminName":null,"mediaType":null,"mediaUrl":null,"previewUrl":null},{"id":"605179652977721566","text":"ขอบคุณค่ะ","type":"incoming","sender":"user","timestamp":1773546486418,"status":null,"adminId":null,"adminName":null,"mediaType":null,"mediaUrl":null,"previewUrl":null},{"id":"605180910732050569","text":"สอบถามค่ะ ถ้าเพิ่มกุ้งแม่น้ำ 20ที่ เป็นเงินเท่าไหร่คะ","type":"incoming","sender":"user","timestamp":1773547236098,"status":null,"adminId":null,"adminName":null,"mediaType":null,"mediaUrl":null,"previewUrl":null},{"id":"605199949483475118","text":"เดี๋ยวแจ้งไปนะคะ","type":"incoming","sender":"user","timestamp":1773558584211,"status":null,"adminId":null,"adminName":null,"mediaType":null,"mediaUrl":null,"previewUrl":null},{"id":"605200110326383052","text":"ใช้เตนท์ค่ะ เดี๋ยวแจ้งจุดที่ตั้งให้ค่ะ\nโต๊ะจีนใช้เก้าอี้ทางร้าน แต่บุฟเฟ่ใช้ของบริษัทค่ะ\nเพิ่มเวทีพระ\nเพิ่มพนักงาน2","type":"incoming","sender":"user","timestamp":1773558679951,"status":null,"adminId":null,"adminName":null,"mediaType":null,"mediaUrl":null,"previewUrl":null},{"id":"605220224899744068","text":"คอนเฟิร์มอาหาร\n\nเมนูโต๊ะจีน \n1/ข้าวเกรียบ \n2/หอยจ้อปู  \n3/กระเพราะปลาเนื้อปู \n4/ขาหมู น้ำ แดง \n5/กุ้งอบ วุ้นเส้น \n6/ปลากระพงราดน้ำยำมะม่วง \n7/กุ้งทอดกระเทียมพริกใทย \n8/ต้มยำโป๊ะแตก \n9/ข้าวผัดปู \n10/เต้าทึง\nเครื่องดื่ม น้ำเปล่า 2 น้ำอัดลม 2 โซดา 4 น้ำแข็งตลอดทั้งงาน\n\nเมนูบุฟเฟต์ \nแกงเขียวหวานลูกชิ้นปลากราย \nต้มยำทะเลน้ำใส (รสเข้มข้น)\nน้ำพริกไข่ปู\nขาหมูน้ำแดงอบซอสยอดผัก \nหมึกผัดไข่เค็ม (รสเข้มข้น)\nลอดช่อง แตงไทย เผือก\nผลไม้\n\nเพิ่มเติม\n-เพิ่มเวทีพระ\n-โต๊ะจีนใช้เก้าอี้ทางร้าน หน้าโต๊ะของไอริส\n-บุฟเฟต์ ใช่ของไอริส ทั้งหมด\n-เพิ่มพนักงานเสิฟ 2 คน\n","type":"incoming","sender":"user","timestamp":1773570669171,"status":null,"adminId":null,"adminName":null,"mediaType":null,"mediaUrl":null,"previewUrl":null},{"id":"605223020688310495","text":"เต็นท์ 2 ลัง ตั้งที่ข้างร้านหน้ามหานครคาราโอเกะ\n\nส่วนด้านหน้าที่ตั้งบุฟเฟ่จะมีเต็นท์แอร์ 1 ลัง\n\nไม่เพิ่มค่ะ","type":"incoming","sender":"user","timestamp":1773572335775,"status":null,"adminId":null,"adminName":null,"mediaType":null,"mediaUrl":null,"previewUrl":null},{"id":"605223092176027990","text":"ดอกไม้ไม่ได้เตรียมมาให้หรอคะ","type":"incoming","sender":"user","timestamp":1773572378275,"status":null,"adminId":null,"adminName":null,"mediaType":null,"mediaUrl":null,"previewUrl":null},{"id":"605226939560493300","text":"เต็นท์ 2 ลัง ตั้งที่ข้างร้านหน้ามหานครคาราโอเกะค่ะ","type":"incoming","sender":"user","timestamp":1773574671441,"status":null,"adminId":null,"adminName":null,"mediaType":null,"mediaUrl":null,"previewUrl":null},{"id":"605307588578115860","text":"รับพระที่วัดชัยวันที่ 25/3/69\nพระฉันเพล บอกจากพัทยาบิวตี้ค่ะ","type":"incoming","sender":"user","timestamp":1773622742127,"status":null,"adminId":null,"adminName":null,"mediaType":null,"mediaUrl":null,"previewUrl":null},{"id":"605307662380302495","text":"ขอตารางเวลาจัดงานหน่อยค่ะ \nเวลาพระ เวลาโต๊ะจีน","type":"incoming","sender":"user","timestamp":1773622786161,"status":null,"adminId":null,"adminName":null,"mediaType":null,"mediaUrl":null,"previewUrl":null},{"id":"605314424202854588","text":"อาหารบุฟเฟ่ต์ตั้งในเต็นท์แอร์ค่ะ","type":"incoming","sender":"user","timestamp":1773626816327,"status":null,"adminId":null,"adminName":null,"mediaType":null,"mediaUrl":null,"previewUrl":null},{"id":"605314859621941963","text":"ตามที่แจ้งนี้เลยค่ะ","type":"incoming","sender":"user","timestamp":1773627075863,"status":null,"adminId":null,"adminName":null,"mediaType":null,"mediaUrl":null,"previewUrl":null},{"id":"605634883238756833","text":"ใช่ค่ะ เฉพาะโต๊ะจีนนะคะ","type":"incoming","sender":"user","timestamp":1773817824895,"status":null,"adminId":null,"adminName":null,"mediaType":null,"mediaUrl":null,"previewUrl":null},{"id":"605635301511266362","text":"เต็นท์ขนาด 5x12 ค่ะ","type":"incoming","sender":"user","timestamp":1773818074257,"status":null,"adminId":null,"adminName":null,"mediaType":n