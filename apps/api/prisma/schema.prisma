generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── CRM: Customers (migrated from Firestore `user` collection) ─────

model Customer {
  id                String             @id // Format: {userId}__{channel} for uniqueness per channel
  platformUserId    String             @map("platform_user_id") // Original LINE userId or FB PSID
  displayName       String             @map("display_name")
  nickname          String?            // Admin-editable name, separate from platform displayName
  firstName         String?            @map("first_name")
  lastName          String?            @map("last_name")
  pictureUrl        String?            @map("picture_url")
  profilePic        String?            @map("profile_pic") // Original LINE/FB pic URL
  channel           String             // e.g. "Line_IRIS", "FB_เติมบุญ"
  channelType       ChannelType        @map("channel_type")
  phoneNumber       String?            @map("phone_number")
  phoneClean        String?            @map("phone_clean")     // Digits only: 0912345678
  additionalPhones  String[]           @default([]) @map("additional_phones") // Extra phone numbers
  statusMessage     String?            @map("status_message")

  // Platform read token (LINE markAsReadToken — never expires)
  markAsReadToken   String?            @map("mark_as_read_token")

  // Job info (synced from IRIS Jobs)
  nextJobDate       DateTime?          @map("next_job_date")
  nextJobTitle      String?            @map("next_job_title")
  nextJobNo         String?            @map("next_job_no") // เลขที่งานจาก iris-job เช่น "J2608-014"

  // Chat state
  isPinned          Boolean            @default(false) @map("is_pinned")
  status            ConversationStatus @default(OPEN)
  unreadCount       Int                @default(0) @map("unread_count")
  lastMessageAt     DateTime?          @map("last_message_at")
  lastMessagePreview String?           @map("last_message_preview")

  // Assignment
  assignedToId      String?            @map("assigned_to_id")
  assignedToName    String?            @map("assigned_to_name")
  assignedAt        DateTime?          @map("assigned_at")

  // Timestamps
  firstContactAt    DateTime           @default(now()) @map("first_contact_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  // Relations
  messages          Message[]
  notes             Note[]
  tags              CustomerTag[]
  // slips relation added after migration
  orders            Order[]
  payments          Payment[]
  bookings          Booking[]
  bookingLinks      BookingLink[]

  @@index([platformUserId])
  @@index([channel])
  @@index([channelType])
  @@index([status])
  @@index([lastMessageAt])
  @@index([assignedToId])
  @@index([unreadCount])
  @@index([createdAt])
  @@index([displayName])
  @@map("customers")
}

enum ChannelType {
  LINE
  FACEBOOK
}

enum ConversationStatus {
  OPEN
  FOLLOW_UP
  RESOLVED
}

// ─── CRM: Messages (migrated from Firestore subcollection) ──────────

model Message {
  id            String      @id // Original message ID from LINE/FB
  customerId    String      @map("customer_id")
  text          String?
  type          MessageType
  sender        SenderType
  timestamp     BigInt      // Unix ms from LINE/FB
  status        String?     // "sent", "delivered", "read", "failed"
  adminId       String?     @map("admin_id")
  adminName     String?     @map("admin_name")

  // Media
  mediaType     MediaType?  @map("media_type")
  mediaUrl      String?     @map("media_url")
  previewUrl    String?     @map("preview_url")

  // Quote reply
  quoteToken    String?     @map("quote_token")
  replyToId     String?     @map("reply_to_id")
  replyTo       Message?    @relation("ReplyTo", fields: [replyToId], references: [id], onDelete: SetNull)
  replies       Message[]   @relation("ReplyTo")

  createdAt     DateTime    @default(now()) @map("created_at")

  customer      Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)

  reactions     MessageReaction[]

  @@index([customerId, timestamp])
  @@index([customerId, createdAt])
  @@index([timestamp])
  @@map("messages")
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String   @map("message_id")
  adminId   String   @map("admin_id")
  adminName String   @map("admin_name")
  emoji     String   // e.g. "👍", "❤️", "😂"
  createdAt DateTime @default(now()) @map("created_at")

  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, adminId])
  @@index([messageId])
  @@map("message_reactions")
}

enum MessageType {
  INCOMING
  OUTGOING
}

enum SenderType {
  USER
  ADMIN
}

enum MediaType {
  IMAGE
  VIDEO
  STICKER
}

// ─── CRM: Tags ──────────────────────────────────────────────────────

model Tag {
  id        String        @id @default(uuid())
  name      String        @unique
  color     String        @default("#6366f1") // Hex color for display
  createdAt DateTime      @default(now()) @map("created_at")
  customers CustomerTag[]

  @@map("tags")
}

model CustomerTag {
  customerId String   @map("customer_id")
  tagId      String   @map("tag_id")
  createdAt  DateTime @default(now()) @map("created_at")

  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([customerId, tagId])
  @@map("customer_tags")
}

// ─── CRM: Notes (private admin notes per customer) ──────────────────

model Note {
  id         String   @id @default(uuid())
  customerId String   @map("customer_id")
  text       String
  authorId   String   @map("author_id") // Firebase Auth UID
  authorName String   @map("author_name")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@map("notes")
}

// ─── CRM: Reply Templates ───────────────────────────────────────────

model ReplyTemplate {
  id        String   @id @default(uuid())
  title     String
  text      String
  category  String?
  images    String[] @default([])
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@map("reply_templates")
}

// ─── Slip Detection ─────────────────────────────────────────────────

model Slip {
  id              String    @id
  imageUrl        String    @map("image_url")
  customerId      String    @map("customer_id")
  channel         String?
  bankName        String?   @map("bank_name")
  amount          Decimal?  @db.Decimal(12, 2)
  dateTime        String?   @map("date_time")
  senderName      String?   @map("sender_name")
  receiverName    String?   @map("receiver_name")
  referenceNumber String?   @map("reference_number")
  detectedAt      DateTime  @default(now()) @map("detected_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  // FK added after migration — customer may not exist yet

  @@index([customerId])
  @@index([bankName])
  @@index([detectedAt])
  @@index([amount])
  @@map("slips")
}

// ─── Orders ─────────────────────────────────────────────────────────

model Order {
  id          String      @id @default(uuid())
  orderNumber String      @unique @map("order_number")
  customerId  String      @map("customer_id")
  channel     String
  status      OrderStatus @default(PENDING)
  totalAmount Decimal     @db.Decimal(12, 2)
  note        String?
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  customer    Customer    @relation(fields: [customerId], references: [id])
  items       OrderItem[]
  payments    Payment[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String  @map("order_id")
  name      String
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2) @map("unit_price")
  total     Decimal @db.Decimal(12, 2)
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model Payment {
  id              String        @id @default(uuid())
  orderId         String?       @map("order_id")
  customerId      String        @map("customer_id")
  amount          Decimal       @db.Decimal(12, 2)
  method          PaymentMethod @default(TRANSFER)
  status          PaymentStatus @default(PENDING)
  slipId          String?       @map("slip_id")
  bankName        String?       @map("bank_name")
  referenceNumber String?       @map("reference_number")
  verifiedAt      DateTime?     @map("verified_at")
  verifiedBy      String?       @map("verified_by")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  customer        Customer      @relation(fields: [customerId], references: [id])
  order           Order?        @relation(fields: [orderId], references: [id])

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("payments")
}

enum PaymentMethod {
  TRANSFER
  CASH
  CREDIT_CARD
  PROMPTPAY
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
}

// ─── Admins ────────────────────────────────────────────────────────

model Admin {
  id         String    @id // Firebase Auth UID
  email      String    @unique
  name       String
  avatar     String?
  role       AdminRole @default(AGENT)
  isActive   Boolean   @default(true) @map("is_active")
  lastSeenAt DateTime? @map("last_seen_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  pushTokens PushToken[]

  @@map("admins")
}

model PushToken {
  id        String   @id @default(uuid())
  adminId   String   @map("admin_id")
  token     String   @unique
  platform  String   // "ios", "android"
  createdAt DateTime @default(now()) @map("created_at")

  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("push_tokens")
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  AGENT
}

// ─── Auth Logs ─────────────────────────────────────────────────────

model AuthLog {
  id        String   @id @default(uuid())
  adminId   String   @map("admin_id")
  email     String
  action    String   // "login", "logout", "token_refresh", "login_failed"
  ip        String?
  userAgent String?  @map("user_agent")
  platform  String?  // "web", "mobile_ios", "mobile_android"
  createdAt DateTime @default(now()) @map("created_at")

  @@index([adminId])
  @@index([createdAt])
  @@index([action])
  @@map("auth_logs")
}

// ─── API Keys ──────────────────────────────────────────────────────

model ApiKey {
  id          String   @id @default(uuid())
  name        String   // "IRIS HR", "Catering App", etc.
  key         String   @unique
  createdBy   String   @map("created_by") // admin ID
  isActive    Boolean  @default(true) @map("is_active")
  lastUsedAt  DateTime? @map("last_used_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([key])
  @@index([isActive])
  @@map("api_keys")
}

// ─── Knowledge Base ───────────────────────────────────────────────

model KnowledgeEntry {
  id        String   @id @default(uuid())
  service   String   // "งานบุญ/พิธีสงฆ์", "อาหารไทยบุฟเฟต์", "โต๊ะจีน", "Cocktail/Canapé", "งานแต่งงาน", "International Buffet"
  category  String   // "ราคา", "FAQ", "ข้อมูลทั่วไป", "แพคเกจ", etc.
  question  String   // The question or topic
  answer    String   // The answer content
  keywords  String?  // Search keywords, comma separated
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([service])
  @@index([isActive])
  @@map("knowledge_entries")
}

model SystemSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Decimal  @db.Decimal(12, 2)
  category    String?
  imageUrl    String?  @map("image_url")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@map("products")
}

// ─── Merit Booking (หน้าจองแพคเกจงานบุญ /booking) ────────────────────

enum BookingStatus {
  NEW
  CONTACTED
  CONFIRMED
  DONE
}

model Booking {
  id             String        @id @default(uuid())
  code           String        @unique // TB-YYMMDD-NNN
  status         BookingStatus @default(NEW)

  occasion       String
  eventDate      String        @map("event_date") // YYYY-MM-DD as entered
  timeSlot       String        @map("time_slot")
  tambon         String?
  amphoe         String?
  province       String?
  zip            String?
  venue          String?

  packageId      String        @map("package_id")
  packageName    String        @map("package_name")
  foodMode       String        @map("food_mode") // buffet | table | none
  guests         Int
  tables         Int
  monks          Int
  selfTransport  Boolean       @default(false) @map("self_transport")
  addons         String[]      @default([])
  budget         String?

  customerName   String        @map("customer_name")
  phone          String
  customerAddress String?      @map("customer_address") // billing address for the quotation (composed from billing* below)
  billingName     String?      @map("billing_name") // company/person the quotation is issued to (null = customerName)
  taxId           String?      @map("tax_id")
  billingLine     String?      @map("billing_line")
  billingTambon   String?      @map("billing_tambon")
  billingAmphoe   String?      @map("billing_amphoe")
  billingProvince String?      @map("billing_province")
  billingZip      String?      @map("billing_zip")
  floor           String?      // floor of the venue (affects the price estimate)
  note           String?
  estimatedTotal Int           @map("estimated_total")

  // Attribution: which chat customer / channel / sales the booking came from
  source           String       @default("web") // web | chat_link
  customerId       String?      @map("customer_id")
  linkId           String?      @map("link_id")
  channel          String?
  chatCustomerName String?      @map("chat_customer_name")
  salesId          String?      @map("sales_id")
  salesName        String?      @map("sales_name")
  customer         Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  link             BookingLink? @relation(fields: [linkId], references: [id], onDelete: SetNull)

  // Quotation created in flowaccount-app (externalRef = booking code)
  quotationDocNo     String?   @map("quotation_doc_no")
  quotationUrl       String?   @map("quotation_url")
  quotationPublicUrl String?   @map("quotation_public_url") // read-only link the customer can open without login
  quotationCreatedAt DateTime? @map("quotation_created_at")

  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([customerId])
  @@index([phone])
  @@map("bookings")
}

/// Unique /booking/?ref=<token> link handed to a chat customer, so bookings made through it
/// are attributed to that customer, channel and the sales admin who sent it.
model BookingLink {
  id            String    @id @default(uuid())
  token         String    @unique
  customerId    String    @map("customer_id")
  channel       String
  channelType   String    @map("channel_type")
  customerName  String    @map("customer_name")
  phone         String?
  packageId     String?   @map("package_id")
  // Quick booking: sales fixed the whole package; the customer only fills personal details
  preset        Json?
  packageName   String?   @map("package_name")
  estimatedTotal Int?     @map("estimated_total")
  createdById   String?   @map("created_by_id")
  createdByName String?   @map("created_by_name")
  openCount     Int       @default(0) @map("open_count")
  lastOpenedAt  DateTime? @map("last_opened_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  bookings      Booking[]

  @@index([customerId])
  @@map("booking_links")
}
