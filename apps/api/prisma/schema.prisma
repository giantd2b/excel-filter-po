generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── CRM: Customers (migrated from Firestore `user` collection) ─────

model Customer {
  id                String             @id // Format: {userId}__{channel} for uniqueness per channel
  platformUserId    String             @map("platform_user_id") // Original LINE userId or FB PSID
  displayName       String             @map("display_name")
  nickname          String?            // Admin-editable name, separate from platform displayName
  firstName         String?            @map("first_name")
  lastName          String?            @map("last_name")
  pictureUrl        String?            @map("picture_url")
  profilePic        String?            @map("profile_pic") // Original LINE/FB pic URL
  channel           String             // e.g. "Line_IRIS", "FB_เติมบุญ"
  channelType       ChannelType        @map("channel_type")
  phoneNumber       String?            @map("phone_number")
  phoneClean        String?            @map("phone_clean")     // Digits only: 0912345678
  statusMessage     String?            @map("status_message")

  // Platform read token (LINE markAsReadToken — never expires)
  markAsReadToken   String?            @map("mark_as_read_token")

  // Chat state
  status            ConversationStatus @default(OPEN)
  unreadCount       Int                @default(0) @map("unread_count")
  lastMessageAt     DateTime?          @map("last_message_at")
  lastMessagePreview String?           @map("last_message_preview")

  // Assignment
  assignedToId      String?            @map("assigned_to_id")
  assignedToName    String?            @map("assigned_to_name")
  assignedAt        DateTime?          @map("assigned_at")

  // Timestamps
  firstContactAt    DateTime           @default(now()) @map("first_contact_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  // Relations
  messages          Message[]
  notes             Note[]
  tags              CustomerTag[]
  // slips relation added after migration
  orders            Order[]
  payments          Payment[]

  @@index([platformUserId])
  @@index([channel])
  @@index([channelType])
  @@index([status])
  @@index([lastMessageAt])
  @@index([assignedToId])
  @@index([unreadCount])
  @@index([createdAt])
  @@index([displayName])
  @@map("customers")
}

enum ChannelType {
  LINE
  FACEBOOK
}

enum ConversationStatus {
  OPEN
  FOLLOW_UP
  RESOLVED
}

// ─── CRM: Messages (migrated from Firestore subcollection) ──────────

model Message {
  id            String      @id // Original message ID from LINE/FB
  customerId    String      @map("customer_id")
  text          String?
  type          MessageType
  sender        SenderType
  timestamp     BigInt      // Unix ms from LINE/FB
  status        String?     // "sent", "delivered", "read", "failed"
  adminId       String?     @map("admin_id")
  adminName     String?     @map("admin_name")

  // Media
  mediaType     MediaType?  @map("media_type")
  mediaUrl      String?     @map("media_url")
  previewUrl    String?     @map("preview_url")

  createdAt     DateTime    @default(now()) @map("created_at")

  customer      Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, timestamp])
  @@index([customerId, createdAt])
  @@index([timestamp])
  @@map("messages")
}

enum MessageType {
  INCOMING
  OUTGOING
}

enum SenderType {
  USER
  ADMIN
}

enum MediaType {
  IMAGE
  VIDEO
}

// ─── CRM: Tags ──────────────────────────────────────────────────────

model Tag {
  id        String        @id @default(uuid())
  name      String        @unique
  color     String        @default("#6366f1") // Hex color for display
  createdAt DateTime      @default(now()) @map("created_at")
  customers CustomerTag[]

  @@map("tags")
}

model CustomerTag {
  customerId String   @map("customer_id")
  tagId      String   @map("tag_id")
  createdAt  DateTime @default(now()) @map("created_at")

  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([customerId, tagId])
  @@map("customer_tags")
}

// ─── CRM: Notes (private admin notes per customer) ──────────────────

model Note {
  id         String   @id @default(uuid())
  customerId String   @map("customer_id")
  text       String
  authorId   String   @map("author_id") // Firebase Auth UID
  authorName String   @map("author_name")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@map("notes")
}

// ─── CRM: Reply Templates ───────────────────────────────────────────

model ReplyTemplate {
  id        String   @id @default(uuid())
  title     String
  text      String
  category  String?
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@map("reply_templates")
}

// ─── Slip Detection ─────────────────────────────────────────────────

model Slip {
  id              String    @id
  imageUrl        String    @map("image_url")
  customerId      String    @map("customer_id")
  channel         String?
  bankName        String?   @map("bank_name")
  amount          Decimal?  @db.Decimal(12, 2)
  dateTime        String?   @map("date_time")
  senderName      String?   @map("sender_name")
  receiverName    String?   @map("receiver_name")
  referenceNumber String?   @map("reference_number")
  detectedAt      DateTime  @default(now()) @map("detected_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  // FK added after migration — customer may not exist yet

  @@index([customerId])
  @@index([bankName])
  @@index([detectedAt])
  @@index([amount])
  @@map("slips")
}

// ─── Orders ─────────────────────────────────────────────────────────

model Order {
  id          String      @id @default(uuid())
  orderNumber String      @unique @map("order_number")
  customerId  String      @map("customer_id")
  channel     String
  status      OrderStatus @default(PENDING)
  totalAmount Decimal     @db.Decimal(12, 2)
  note        String?
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  customer    Customer    @relation(fields: [customerId], references: [id])
  items       OrderItem[]
  payments    Payment[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String  @map("order_id")
  name      String
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2) @map("unit_price")
  total     Decimal @db.Decimal(12, 2)
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model Payment {
  id              String        @id @default(uuid())
  orderId         String?       @map("order_id")
  customerId      String        @map("customer_id")
  amount          Decimal       @db.Decimal(12, 2)
  method          PaymentMethod @default(TRANSFER)
  status          PaymentStatus @default(PENDING)
  slipId          String?       @map("slip_id")
  bankName        String?       @map("bank_name")
  referenceNumber String?       @map("reference_number")
  verifiedAt      DateTime?     @map("verified_at")
  verifiedBy      String?       @map("verified_by")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  customer        Customer      @relation(fields: [customerId], references: [id])
  order           Order?        @relation(fields: [orderId], references: [id])

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("payments")
}

enum PaymentMethod {
  TRANSFER
  CASH
  CREDIT_CARD
  PROMPTPAY
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
}

// ─── Admins ────────────────────────────────────────────────────────

model Admin {
  id         String    @id // Firebase Auth UID
  email      String    @unique
  name       String
  avatar     String?
  role       AdminRole @default(AGENT)
  isActive   Boolean   @default(true) @map("is_active")
  lastSeenAt DateTime? @map("last_seen_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  pushTokens PushToken[]

  @@map("admins")
}

model PushToken {
  id        String   @id @default(uuid())
  adminId   String   @map("admin_id")
  token     String   @unique
  platform  String   // "ios", "android"
  createdAt DateTime @default(now()) @map("created_at")

  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("push_tokens")
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  AGENT
}

// ─── Auth Logs ─────────────────────────────────────────────────────

model AuthLog {
  id        String   @id @default(uuid())
  adminId   String   @map("admin_id")
  email     String
  action    String   // "login", "logout", "token_refresh", "login_failed"
  ip        String?
  userAgent String?  @map("user_agent")
  platform  String?  // "web", "mobile_ios", "mobile_android"
  createdAt DateTime @default(now()) @map("created_at")

  @@index([adminId])
  @@index([createdAt])
  @@index([action])
  @@map("auth_logs")
}

// ─── Knowledge Base ───────────────────────────────────────────────

model KnowledgeEntry {
  id        String   @id @default(uuid())
  service   String   // "งานบุญ/พิธีสงฆ์", "อาหารไทยบุฟเฟต์", "โต๊ะจีน", "Cocktail/Canapé", "งานแต่งงาน", "International Buffet"
  category  String   // "ราคา", "FAQ", "ข้อมูลทั่วไป", "แพคเกจ", etc.
  question  String   // The question or topic
  answer    String   // The answer content
  keywords  String?  // Search keywords, comma separated
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([service])
  @@index([isActive])
  @@map("knowledge_entries")
}

model SystemSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Decimal  @db.Decimal(12, 2)
  category    String?
  imageUrl    String?  @map("image_url")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@map("products")
}
