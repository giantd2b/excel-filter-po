# Anthropic (slip detection)
ANTHROPIC_API_KEY=sk-ant-xxx

# LINE Access Tokens
LINE_TOKEN_IRIS=xxx
LINE_TOKEN_TERMBOON=xxx
LINE_TOKEN_TEST=xxx
LINE_TOKEN_CHON=xxx
LINE_TOKEN_TOHJEEN=xxx

# LINE Notification Group (slip alerts + daily slip report)
LINE_GROUP_ID=C65701e283ed16aa48fd407edc5e6374f
LINE_GROUP_ACCESS_TOKEN=xxx

# IRIS BOT — same LINE channel iris-job uses for team alerts. New-booking cards
# are pushed into this group; the bot must already be a member of it.
IRIS_BOT_ACCESS_TOKEN=xxx
BOOKING_ALERT_LINE_GROUP_ID=C38f6000e5944ef97a36ca4aac736253a

# Facebook Page Tokens
FB_IRIS_TOKEN=xxx
FB_IRIS_RAYONG_TOKEN=xxx
FB_TERMBOON_TOKEN=xxx
FB_CHON_TOKEN=xxx
FB_TOHJEEN_TOKEN=xxx
FB_TEST_TOKEN=xxx
