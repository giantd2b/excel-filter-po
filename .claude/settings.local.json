      "Bash(FIRESTORE_EMULATOR_HOST=localhost:8080 node -e \"\nconst admin = require\\('firebase-admin'\\);\nadmin.initializeApp\\({ projectId: 'excel-filter-po' }\\);\nconst db = admin.firestore\\(\\);\n\nasync function compare\\(\\) {\n  // Check 5 LINE_IRIS users for messages in emulator\n  const users = await db.collection\\('user'\\)\n    .where\\('channel', '==', 'Line_IRIS'\\)\n    .orderBy\\('lastmessagetime', 'desc'\\)\n    .limit\\(5\\)\n    .get\\(\\);\n\n  console.log\\('=== Emulator: LINE_IRIS users ==='\\);\n  for \\(const doc of users.docs\\) {\n    const msgs = await db.collection\\('user'\\).doc\\(doc.id\\).collection\\('messages'\\).get\\(\\);\n    console.log\\(doc.id, '|', doc.data\\(\\).displayName, '| messages:', msgs.size\\);\n  }\n\n  // Check 5 LINE_เติมบุญ users\n  const users2 = await db.collection\\('user'\\)\n    .where\\('channel', '==', 'Line_เติมบุญ'\\)\n    .orderBy\\('lastmessagetime', 'desc'\\)\n    .limit\\(5\\)\n    .get\\(\\);\n\n  console.log\\('\\\\n=== Emulator: Line_เติมบุญ users ==='\\);\n  for \\(const doc of users2.docs\\) {\n    const msgs = await db.collection\\('user'\\).doc\\(doc.id\\).collection\\('messages'\\).get\\(\\);\n    console.log\\(doc.id, '|', doc.data\\(\\).displayName, '| messages:', msgs.size\\);\n  }\n\n  // Total message count across a sample\n  let totalMsgs = 0;\n  let usersChecked = 0;\n  let usersWithMsgs = 0;\n  const allUsers = await db.collection\\('user'\\).limit\\(200\\).get\\(\\);\n  for \\(const doc of allUsers.docs\\) {\n    const msgs = await db.collection\\('user'\\).doc\\(doc.id\\).collection\\('messages'\\).get\\(\\);\n    if \\(msgs.size > 0\\) {\n      usersWithMsgs++;\n      totalMsgs += msgs.size;\n    }\n    usersChecked++;\n  }\n  console.log\\('\\\\n=== Sample of 200 users ==='\\);\n  console.log\\('Users with messages:', usersWithMsgs\\);\n  console.log\\('Total messages:', totalMsgs\\);\n}\ncompare\\(\\).catch\\(console.error\\);\n\" 2>&1)",
