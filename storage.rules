rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // photos folder - public read for profile pictures
    match /photos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth!=null;
    }
    // profile folder - public read for FB profile pictures
    match /profile/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth!=null;
    }
    // Other files require auth
    match /{allPaths=**} {
      allow read, write: if request.auth!=null;
    }
  }
}
